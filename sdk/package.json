{
  "name": "@zksoroban/sdk",
  "version": "0.2.0",
  "description": "TypeScript SDK for Soroban zero-knowledge proof formatting and verification",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/types/index.d.ts",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/types/browser.d.ts",
      "import": "./dist/browser/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node init && npm run build:cjs && npm run build:esm && npm run build:types && npm run build:browser && node scripts/postbuild.cjs",
    "build:cjs": "node init && tsc -p tsconfig.cjs.json",
    "build:esm": "node init && tsc -p tsconfig.esm.json",
    "build:types": "node init && tsc -p tsconfig.types.json",
    "build:browser": "node init && vite build",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && tsx --test --require ./test/snapshot-setup.ts --test-force-exit test/**/*.ts",
    "test:unit": "npm test",
    "test:golden": "tsx scripts/golden.ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.0.1",
    "circomlibjs": "^0.1.7",
    "ffjavascript": "^0.3.1"
  },
  "peerDependencies": {
    "snarkjs": "^0.7.5"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
